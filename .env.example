# Copy to .env and fill in. Never commit the real .env file (see .gitignore).

# --- PostgreSQL (Azure Database for PostgreSQL Flexible Server) ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=greenlux
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Cosmos DB (NoSQL / Core API) ---
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=greenlux
COSMOS_CONTAINER=esg_holdings

# --- Azure AI Foundry / Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- LangSmith ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=greenlux-sentinel
# EU-hosted workspaces need this; US-hosted workspaces should use the default (omit this line).
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com

# --- Power BI ---
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=

# --- GLEIF API ---
# Public, no key required: https://api.gleif.org/api/v1
GLEIF_API_BASE_URL=https://api.gleif.org/api/v1

# --- ADLS Gen2 landing zone (etl_agent.py's fallback when data/raw/ isn't present locally) ---
# Storage account name only, not a connection string -- access is via DefaultAzureCredential.
# Leave blank for local dev with data/raw/ checked out.
LANDING_STORAGE_ACCOUNT_NAME=

# --- Agent API (src/greenlux_sentinel/api/app.py) ---
# Bearer token required on incoming requests. Leave blank for local dev (auth skipped) -- see
# api/app.py's module docstring.
API_AUTH_TOKEN=

# --- Azure Key Vault (production; local dev can leave blank and use the vars above) ---
AZURE_KEY_VAULT_URL=
