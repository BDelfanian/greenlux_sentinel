# Copy to .env.local for local dev. Points at the FastAPI agent API
# (src/greenlux_sentinel/api/app.py), run separately via:
#   uvicorn greenlux_sentinel.api.app:app --reload
AGENT_API_URL=http://localhost:8000

# Only needed if the target API has api_auth_token set (local dev default leaves it blank,
# so auth is skipped -- see api/app.py's module docstring). Required when pointing this UI
# at the deployed Container App, which reads the real token from Key Vault.
AGENT_API_TOKEN=
